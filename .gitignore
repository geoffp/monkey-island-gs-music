# User-supplied, non-redistributable data (game files, MT-32 ROMs): never commit
/original files/
# Fetched/built by `just fetch`
/vendor/
# Python (uv)
.venv/
__pycache__/
*.pyc
# Working copies of IIGS disk images (`just disks`)
/gs/disks/
# Generated from the game data (`just extract` / `just render`); copyrighted music, never commit
/music/midi/
/music/patches/
/music/wav/
# Generated sequences (derived from the soundtrack)
/gs/seq/
# Build intermediates (Munt sample renders)
/gs/build/
